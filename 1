local foodMapping = {
    ["蛋白质棒"] = { toolName = "Protein Bar" },
    ["能量棒"] = { toolName = "Energy Bar" },
    ["健壮条"] = { toolName = "TOUGH Bar" },
    ["蛋白质奶昔"] = { toolName = "Protein Shake" },
    ["超级奶昔"] = { toolName = "ULTRA Shake" },
    ["能量奶昔"] = { toolName = "Energy Shake" },
    ["菠萝"] = { toolName = "Tropical Shake" }
}

local currentFoodIndex = 1

local function getAvailableFoods()
    local availableFoods = {}
    local backpack = LocalPlayer.Backpack
    for _, foodName in ipairs(foodOptions) do
        local toolName = foodMapping[foodName].toolName
        if backpack:FindFirstChild(toolName) then
            table.insert(availableFoods, foodName)
        end
    end
    return availableFoods
end

local function equipFood(foodData)
    if not foodData then
        return false
    end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end

    local tool = character:FindFirstChildOfClass("Tool")
    if tool and tool.Name == foodData.toolName then
        return true
    else
        local backpack = LocalPlayer.Backpack
        local targetTool = backpack:FindFirstChild(foodData.toolName)
        if targetTool then
            for _, item in pairs(character:GetChildren()) do
                if item:IsA("Tool") then
                    humanoid:UnequipTools()
                    break
                end
            end
            task.wait(0.1)
            humanoid:EquipTool(targetTool)
            task.wait(0.2)
            tool = character:FindFirstChildOfClass("Tool")
            if tool and tool.Name == foodData.toolName then
                return true
            end
        end
    end
    return false
end

local function checkFoodStillExists(foodData)
    local backpack = LocalPlayer.Backpack
    return backpack:FindFirstChild(foodData.toolName) ~= nil
end

local function shakeLoop()
    while _G.auto_shake do
        if currentFoodIndex > #foodOptions then
            currentFoodIndex = 1
            task.wait(0.5)
        end

        local currentFoodName = foodOptions[currentFoodIndex]
        local currentFoodData = foodMapping[currentFoodName]
        
        if checkFoodStillExists(currentFoodData) then
            if equipFood(currentFoodData) then
                VirtualUser:Button1Down(Vector2.new(10, 10), workspace.CurrentCamera.CFrame)
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(10, 10), workspace.CurrentCamera.CFrame)
            end
            task.wait(0.1)
        else
            currentFoodIndex = currentFoodIndex + 1
            task.wait(0.2)
        end
    end
end

