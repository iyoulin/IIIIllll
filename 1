-- ==================== 辅助函数 ====================
local function stopThread(threadVar)
    if threadVar then
        task.cancel(threadVar)
        threadVar = nil
    end
end

local function getPlayerList()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end
    end
    return list
end

local function countEggs()
    local backpack = LocalPlayer.Backpack
    local eggCount = 0
    local eggNames = { "Protein Egg" }
    
    for _, eggName in ipairs(eggNames) do
        local eggs = backpack:GetChildren()
        for _, item in ipairs(eggs) do
            if item:IsA("Tool") and item.Name == eggName then
                eggCount = eggCount + 1
            end
        end
    end
    
    return eggCount
end

local function hasProteinEggEffect()
    local boostTimers = LocalPlayer:FindFirstChild("boostTimersFolder")
    return boostTimers and boostTimers:FindFirstChild("Protein Egg") ~= nil
end

-- ==================== 自动吃蛋 ====================
local function eatEggsLoop()
    local lastClickTime = 0
    local eggToolName = "Protein Egg"
    local eatenCount = 0

    while _G.auto_eat_eggs do
        pcall(function()
            if _G.egg_eat_count > 0 and eatenCount >= _G.egg_eat_count then
                print("已达到目标吃蛋数量: " .. _G.egg_eat_count .. "，停止吃蛋")
                _G.auto_eat_eggs = false
                WindUI:Notify({
                    Title = "吃蛋完成",
                    Content = "已吃掉 " .. eatenCount .. " 个蛋",
                    Duration = 3
                })
                return
            end

            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then
                task.wait(0.5)
                return
            end

            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid then
                task.wait(0.5)
                return
            end

            local backpack = LocalPlayer.Backpack
            local eggTool = backpack:FindFirstChild(eggToolName)
            
            if eggTool then
                local currentTool = character:FindFirstChildOfClass("Tool")
                if not currentTool or currentTool.Name ~= eggToolName then
                    for _, item in pairs(character:GetChildren()) do
                        if item:IsA("Tool") then
                            humanoid:UnequipTools()
                            break
                        end
                    end
                    task.wait(0.1)
                    humanoid:EquipTool(eggTool)
                    task.wait(0.2)
                end

                local equippedTool = character:FindFirstChildOfClass("Tool")
                if equippedTool and equippedTool.Name == eggToolName then
                    local currentTime = tick()
                    if currentTime - lastClickTime >= 0.5 then
                        VirtualUser:Button1Down(Vector2.new(10, 10), workspace.CurrentCamera.CFrame)
                        task.wait(0.05)
                        VirtualUser:Button1Up(Vector2.new(10, 10), workspace.CurrentCamera.CFrame)
                        lastClickTime = currentTime
                        eatenCount = eatenCount + 1
                        print("已吃蛋: " .. eatenCount .. "/" .. _G.egg_eat_count)
                    end
                end
            else
                print("背包中没有蛋了，停止吃蛋")
                _G.auto_eat_eggs = false
                WindUI:Notify({
                    Title = "蛋已吃完",
                    Content = "已吃掉 " .. eatenCount .. " 个蛋，背包已空",
                    Duration = 3
                })
                return
            end
        end)
        task.wait(0.1)
    end
end

