local function getStoneRock(stoneName)
    local machines = workspace.machinesFolder
    
    if stoneName == "蓝石头" then
        local rock = machines:FindFirstChild("Frozen Rock")
        return rock and rock:FindFirstChild("Rock")
        
    elseif stoneName == "紫石头" then
        for _, child in ipairs(machines:GetChildren()) do
            if child.Name == "Frozen Rock" 
                and child:FindFirstChild("durabilityGain") 
                and child.durabilityGain.Value == 30 then
                return child:FindFirstChild("Rock")
            end
        end
        
    elseif stoneName == "橙石头" then
        local rock = machines:FindFirstChild("Inferno Rock")
        return rock and rock:FindFirstChild("Rock")
        
    elseif stoneName == "白石头" then
        local rock = machines:FindFirstChild("Rock Of Legends")
        return rock and rock:FindFirstChild("Rock")
        
    elseif stoneName == "绿石头" then
        local rock = machines:FindFirstChild("Muscle King Mountain")
        return rock and rock:FindFirstChild("Rock")
        
    elseif stoneName == "丛林石头" then
        local rock = machines:FindFirstChild("Ancient Jungle Rock")
        return rock and rock:FindFirstChild("Rock")
        
    elseif stoneName == "沙滩石头" then
        for _, child in ipairs(machines:GetChildren()) do
            if child.Name == "Punching Rock" 
                and child:FindFirstChild("durabilityGain") 
                and child.durabilityGain.Value == 8 then
                return child:FindFirstChild("Rock")
            end
        end
        
    elseif stoneName == "大石头" then
        for _, child in ipairs(machines:GetChildren()) do
            if child.Name == "Punching Rock" 
                and child:FindFirstChild("durabilityGain") 
                and child.durabilityGain.Value == 3 then
                return child:FindFirstChild("Rock")
            end
        end
        
    elseif stoneName == "中石头" then
        for _, child in ipairs(machines:GetChildren()) do
            if child.Name == "Punching Rock" 
                and child:FindFirstChild("durabilityGain") 
                and child.durabilityGain.Value == 2 then
                return child:FindFirstChild("Rock")
            end
        end
    end
    
    return nil
end

